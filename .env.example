# AgroSenseAI Environment Configuration Template

# API Gateway Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=agrosense_super_secret_jwt_key_2026

# Database Configuration (Leave empty to use built-in MongoMemoryServer automatically)
# MONGODB_URI=mongodb://localhost:27017/agrosense

# Decision Engine Service URL
ENGINE_URL=http://127.0.0.1:8000

# Open-Meteo Weather API (Free CC-BY 4.0 tier: attribution required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Frontend Vite Port
VITE_PORT=3000

# Firebase Configuration for Google Authentication (Web Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

